{
  "name": "gnuplot-markdown-preview",
  "displayName": "Gnuplot Markdown Preview",
  "description": "Render gnuplot code fences directly in VS Code Markdown Preview using WebAssembly.",
  "version": "0.2.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reonarudo/gnuplot-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Reonarudo/gnuplot-markdown-preview/issues"
  },
  "homepage": "https://github.com/Reonarudo/gnuplot-markdown-preview#readme",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "gnuplot",
    "markdown",
    "plot",
    "plots",
    "graph",
    "chart",
    "visualization",
    "wasm",
    "webassembly",
    "markdown-preview"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Functions and inline datasets work in Restricted Mode. External data files require a trusted local workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Functions and inline datasets work; external data requires a local file workspace."
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "media/preview.css"
    ],
    "commands": [
      {
        "command": "gnuplotMarkdownPreview.refreshData",
        "title": "Gnuplot: Refresh Data"
      }
    ]
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "test:package": "node scripts/test-package.mjs",
    "test:extension": "node scripts/test-extension.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.3",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "publisher": "ReoX86"
}
